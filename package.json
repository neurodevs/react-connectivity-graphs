{
  "name": "@neurodevs/react-connectivity-graphs",
  "version": "5.0.3",
  "description": "Network connectivity graphs with nodes and edges",
  "type": "module",
  "keywords": [
    "nodejs",
    "typescript",
    "tdd"
  ],
  "license": "MIT",
  "author": "Eric Yates <hello@ericthecurious.com>",
  "homepage": "https://github.com/neurodevs/react-connectivity-graphs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neurodevs/react-connectivity-graphs.git"
  },
  "bugs": {
    "url": "https://github.com/neurodevs/react-connectivity-graphs/issues"
  },
  "main": "build/index.js",
  "files": [
    "build/",
    "dist/"
  ],
  "scripts": {
    "build.ci": "yarn run build.tsc && yarn run lint",
    "build.dev": "yarn run build.tsc --sourceMap ; yarn run fix.lint ; prettier --write .",
    "build.exports": "esbuild src/exports.ts --bundle --outfile=build/index.js --platform=browser --loader:.tsx=tsx --loader:.css=css",
    "build.dist": "esbuild src/styles/index.css --bundle --outfile=dist/index.css --loader:.css=css",
    "build.demo": "esbuild src/index.tsx --bundle --outfile=public/dist/index.js --platform=browser --loader:.tsx=tsx --loader:.css=css",
    "build.copy-files": "mkdir -p build && rsync -avzq --exclude='*.ts' ./src/ ./build/",
    "build.tsc": "yarn run build.copy-files && tsc",
    "clean": "yarn run clean.build",
    "clean.all": "yarn run clean.dependencies && yarn run clean.build",
    "clean.build": "rm -rf build/",
    "clean.dependencies": "rm -rf node_modules/ package-lock.json yarn.lock",
    "dev": "yarn run build.dev && cp dist/index.css public/dist/; npx serve -s public",
    "fix.lint": "eslint --fix --cache '**/*.ts'",
    "lint": "eslint --cache '**/*.ts'",
    "rebuild": "yarn run clean.all && yarn install && yarn run build.dev",
    "update.dependencies": "yarn run clean.dependencies && yarn",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "watch.build.dev": "tsc-watch --sourceMap --onCompilationComplete 'yarn run build.copy-files'"
  },
  "dependencies": {
    "@xyflow/react": "^12.6.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@neurodevs/eslint-config-ndx": "2.0.0",
    "@neurodevs/generate-id": "^1.1.2",
    "@neurodevs/node-tdd": "^1.1.2",
    "@neurodevs/prettier-config-ndx": "^1.0.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "esbuild": "^0.25.4",
    "esbuild-style-plugin": "^1.6.3",
    "jsdom": "^26.0.0",
    "serve": "^14.2.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "jest": {
    "testRunner": "jest-circus/runner",
    "maxWorkers": 4,
    "testTimeout": 5000,
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/build/__tests__/**/*.test.js?(x)"
    ],
    "setupFiles": [
      "<rootDir>/build/__tests__/setupTests.js"
    ]
  }
}
