{
  "name": "@neurodevs/react-connectivity-graphs",
  "version": "2.3.2",
  "main": "build/exports.js",
  "repository": "https://github.com/neurodevs/react-connectivity-graphs.git",
  "scripts": {
    "build.ci": "yarn run build.tsc && yarn run build.resolve-paths && yarn run lint",
    "build.dev": "yarn run build.tsc --sourceMap ; yarn run resolve-paths.lint",
    "build.copy-files": "mkdir -p build && rsync -avzq --exclude='*.ts' ./src/ ./build/",
    "build.resolve-paths": "resolve-path-aliases --target build --patterns '**/*.js,**/*.d.ts'",
    "build.tsc": "yarn run build.copy-files && tsc",
    "clean": "yarn run clean.build",
    "clean.all": "yarn run clean.dependencies && yarn run clean.build",
    "clean.build": "rm -rf build/",
    "clean.dependencies": "rm -rf node_modules/ package-lock.json yarn.lock",
    "dev": "yarn dev.build & npx serve -s public",
    "dev.build": "yarn dev.build.browser && yarn run dev.copy.reactflow",
    "dev.build.browser": "esbuild src/index.tsx --bundle --platform=browser --outfile=public/dist/index.js --loader:.tsx=tsx --jsx=automatic --watch=forever",
    "dev.copy.reactflow": "cp node_modules/@xyflow/react/dist/style.css public/reactflow.css",
    "fix.lint": "eslint --fix --cache '**/*.ts'",
    "lint": "eslint --cache '**/*.ts'",
    "lint.tsc": "tsc -p . --noEmit",
    "post.watch.build": "yarn run build.copy-files && yarn run build.resolve-paths",
    "rebuild": "yarn run clean.all && yarn install && yarn run build.dev",
    "update.dependencies": "yarn run clean.dependencies && yarn",
    "resolve-paths.lint": "yarn run build.resolve-paths ; yarn run lint",
    "test": "jest",
    "watch.build.dev": "tsc-watch --sourceMap --onCompilationComplete 'yarn run post.watch.build'",
    "watch.rebuild": "yarn run clean.all && yarn install && yarn run watch.build.dev",
    "watch.tsc": "tsc -w"
  },
  "devDependencies": {
    "@sprucelabs/jest-json-reporter": "^9.0.13",
    "@sprucelabs/resolve-path-aliases": "^2.0.531",
    "@sprucelabs/test": "^10.0.5",
    "@sprucelabs/test-utils": "^6.0.18",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.7.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "chokidar-cli": "^3.0.0",
    "esbuild": "^0.25.4",
    "eslint": "^9.12.0",
    "eslint-config-spruce": "^11.2.26",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.3.3",
    "serve": "^14.2.4",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "description": "Network connectivity graphs with nodes and edges",
  "skill": {
    "namespace": "react-connectivity-graphs"
  },
  "jest": {
    "testRunner": "jest-circus/runner",
    "maxWorkers": 4,
    "testTimeout": 120000,
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "<rootDir>/tmp/",
      "<rootDir>/src/",
      "<rootDir>/node_modules/",
      "<rootDir>/build/__tests__/testDirsAndFiles/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js?(x)"
    ],
    "moduleNameMapper": {
      "^#spruce/(.*)$": "<rootDir>/build/.spruce/$1"
    },
    "setupFiles": [
      "<rootDir>/build/__tests__/setupTests.js"
    ]
  },
  "dependencies": {
    "@xyflow/react": "^12.6.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
